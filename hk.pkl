amends "package://github.com/jdx/hk/releases/download/v1.48.0/hk@1.48.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.48.0/hk@1.48.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    ["shellcheck"] = Builtins.shellcheck
    ["check_executables_have_shebangs"] = Builtins.check_executables_have_shebangs
    // Scans changed files for secrets/keys before they can land in this public repo.
    ["gitleaks"] = Builtins.gitleaks

    // Bundled plugin scripts have no .sh extension (run via ${CLAUDE_PLUGIN_ROOT}), so
    // shellcheck them explicitly rather than relying on the builtin's *.sh/*.bash glob.
    // SC2059 suppressed here only (not repo-wide): these scripts' dominant style embeds
    // color-code vars (${BOLD} etc) directly in printf format strings. Safe today only
    // because every one of those ~98 call sites happens to pass a literal string, not
    // because the pattern is structurally safe -- shellcheck has no way to mark a var as
    // "known safe", so it can't tell those apart from a real injection risk. The two
    // spots that actually mattered (verbose()/warn(), generic helpers a future caller
    // could pass dynamic text through) were fixed to use %s instead of suppressed.
    // Better long-term fix: a safe_printf() wrapper that always takes the message via
    // %s and the color codes as separate args, so nothing interpolates into the format
    // string anywhere -- would let this suppression go away entirely. Not done here
    // because it's a ~98-callsite rewrite of an inherited script for an info-level,
    // currently-inert finding.
    ["shellcheck_scripts"] {
        glob = "plugins/*/skills/*/scripts/*"
        check = "shellcheck -e SC2059 {{ files }}"
    }

    ["json_valid"] {
        glob = "**/*.json"
        check = "jq empty {{ files }}"
    }

    ["actionlint"] = Builtins.actionlint
}

hooks {
    // pre-push re-runs the same steps as pre-commit, since pre-commit isn't guaranteed
    // to have run first -- in the case of using jj, which snapshots continuously instead
    // of hooking a discrete "commit" moment, pre-push is the real gate and pre-commit
    // here is best-effort/fluid.
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["pre-push"] {
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
